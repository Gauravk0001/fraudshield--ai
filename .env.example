# ==============================================================================
# FraudShield AI — Production & Environment Configuration
# ==============================================================================

# Core Application Settings
PROJECT_NAME="FraudShield AI"
ENVIRONMENT="production"                     # Options: "development", "production", "testing"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-random-64-character-jwt-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated list for cross-origin cloud hosting, e.g. Vercel frontend)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://your-frontend-app.vercel.app"

# Database Configuration
# Option A: Full Connection URI (Preferred for Cloud Postgres: Supabase, Neon, Railway, Render)
DATABASE_URL="postgresql://fraudshield:fraudshield_secret_pass@localhost:5432/fraudshield_db"

# Option B: Individual Parameters (Used by default in Docker Compose)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fraudshield
POSTGRES_PASSWORD=fraudshield_secret_pass
POSTGRES_DB=fraudshield_db

# Redis Configuration (Real-time Pub/Sub & WebSocket Event Bus)
# Option A: Full Redis URI (Preferred for Upstash / Managed Redis)
REDIS_URL="redis://localhost:6379/0"

# Option B: Individual Parameters (Used by default in Docker Compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# AI Copilot Configuration (Google Gemini GenAI)
# If left empty, Copilot gracefully falls back to deterministic forensic rule-based explanations
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Risk Engine Thresholds (0 - 100 Scale)
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=70

# Frontend Environment Variables (Set in frontend hosting, e.g. Vercel or .env.production)
# VITE_API_URL="https://your-backend-api.onrender.com"
# VITE_WS_URL="wss://your-backend-api.onrender.com"

