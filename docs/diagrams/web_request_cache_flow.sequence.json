    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "ingress-auth",
        "label": "Ingress & Authentication",
        "focus": ["browser", "gateway", "auth"],
        "note": "Browser dispatches HTTPS request; API gateway validates JWT token and RBAC claims."
      },
      {
        "id": "cache-miss-fallback",
        "label": "Cache Check & Miss Fallback",
        "focus": ["gateway", "redis", "postgres"],
        "note": "Gateway queries Redis for key; on cache miss, it queries PostgreSQL authoritative store."
      },
      {
        "id": "fill-cache-response",
        "label": "Cache Fill & Client Response",
        "focus": ["postgres", "gateway", "redis", "audit", "browser"],
        "note": "Authoritative data is populated into Redis with TTL and returned to the browser."
      }
    ]
  },
  "participants": [
