  "cards": [
    {
      "dot": "emerald",
      "title": "Cache-Aside Lifecycle",
      "items": [
        "Client browser invokes FastAPI Gateway with X-Request-ID and Bearer JWT",
        "Gateway verifies identity and attempts read-through lookup from Redis key store",
        "Authoritative query executes against PostgreSQL only upon confirmed cache miss"
      ]
    },
    {
      "dot": "rose",
      "title": "Fallback & Consistency",
      "items": [
        "Cache misses fall back cleanly to PostgreSQL primary with row-level tenant security",
        "Fresh record is written back to Redis with explicit TTL (SETEX) to populate hot cache",
        "Preserves authoritative transaction record integrity while maximizing sub-millisecond warm hits"
      ]
    },
    {
      "dot": "orange",
      "title": "Observability & Audit",
      "items": [
        "Asynchronous audit log event is recorded with distributed request correlation ID",
        "HTTP 200 payload returns to client with sub-15ms response latency"
      ]
    }
  ]
